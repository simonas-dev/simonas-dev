{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "curl -sSfL https://github.com/getzola/zola/releases/download/v0.23.6/zola-v0.23.6-x86_64-unknown-linux-musl.tar.gz | tar -xz",
  "buildCommand": "./zola build",
  "outputDirectory": "public",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/posts/wizard",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/posts/wizard/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/posts/ballistic-wizard",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/posts/ballistic-wizard/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/about",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/about/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/tags/:path*/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/tags/:path*",
      "destination": "/",
      "statusCode": 301
    }
  ]
}
