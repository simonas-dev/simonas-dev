# --- Build output -------------------------------------------------------------
# Zola writes the built site to public/. Source assets live in static/.
/public/
# Video masters stay outside git; only the encodes in static/video/ are served.
*.mov
*.mkv

# --- Dependencies / tooling caches ------------------------------------------
node_modules/
.cache/
/.next/
/out/

# --- Deploy / local env -----------------------------------------------------
.vercel/
.env
.env.*
!.env.example

# --- Agent tooling: share config, ignore local/runtime state -----------------
# .pi/agents and .pi/prompts are shared project config and ARE committed.
.pi/*
!.pi/agents/
!.pi/prompts/

# --- OS / editor ------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json

# --- Logs -------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
.env*
